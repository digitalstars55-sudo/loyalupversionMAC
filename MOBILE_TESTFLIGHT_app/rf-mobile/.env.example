# ════════════════════════════════════════════════════════════════════
# ЛоялUP Mobile — пример конфига для подключения к реальному бэкенду.
# Скопируйте этот файл в .env и поправьте под свою установку.
# ════════════════════════════════════════════════════════════════════

# Только переменные с префиксом EXPO_PUBLIC_ доступны в коде клиента!
# Остальные expo не подхватит и они НЕ попадут в js-бандл.

# Base URL вашего тенанта. Без слеша на конце.
# Примеры:
#   https://demo.levone.ru        — конкретный тенант
#   https://9d23-37.ngrok-free.app — ngrok-туннель локального dev-бэка
EXPO_PUBLIC_API_BASE=https://your-tenant.levone.ru

# Включить мок-режим (без обращения к бэкенду). По умолчанию true,
# чтобы можно было запускать demo без бэка. Поставьте false для прода.
EXPO_PUBLIC_USE_MOCK=true
